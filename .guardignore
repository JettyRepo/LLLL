# LLLL Guard's own source — contains detection patterns and test fixtures.
# `**` so that nested folders (tests/e2e, tests/helpers) are covered: in these patterns a
# single `*` does not cross a directory boundary.
llll-guard/src/scanners/**
llll-guard/src/output/*.ts
llll-guard/tests/**

# Guard detection pattern definitions
plugins/llll/skills/llll/guard-patterns.md
plugins/llll/skills/llll/scan-patterns.md

# Installer scripts — reference AI tool names as config strings, not API integrations
install-opencode.sh
install-codex.sh

# Guard script itself — contains detection pattern strings as source code
guard
