#!/usr/bin/env bash
# LLLL Guard — Pre-push & release compliance gate
# Part of LLLL (Layrix Logic Layer Loop)
# Usage:
#   guard push [--remote <remote>] [--branch <branch>] [--json]
#   guard release [--dir <dir>] [--json]
#   guard override <findingId> <justification>
#   guard install-hook [--force]

set -uo pipefail

GUARD_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/guard"

# ── ANSI colors ────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  RED_BOLD=$'\033[1;31m'
  YELLOW_BOLD=$'\033[1;33m'
  BLUE=$'\033[34m'
  GREEN_BOLD=$'\033[1;32m'
  GRAY=$'\033[90m'
  RESET=$'\033[0m'
else
  RED_BOLD='' YELLOW_BOLD='' BLUE='' GREEN_BOLD='' GRAY='' RESET=''
fi

# ── Finding storage: "ID|TITLE|FILE|LINE|MATCH|CATEGORY|ACTION" ────────────
HARD_FINDINGS=()
SOFT_FINDINGS=()
WARN_FINDINGS=()

# ── Output helpers ─────────────────────────────────────────────────────────

color_verdict() {
  case "$1" in
    HARD_BLOCK) printf "%s%s%s" "$RED_BOLD"    "HARD_BLOCK" "$RESET" ;;
    SOFT_BLOCK) printf "%s%s%s" "$YELLOW_BOLD" "SOFT_BLOCK" "$RESET" ;;
    WARN)       printf "%s%s%s" "$BLUE"        "WARN"       "$RESET" ;;
    PASS)       printf "%s%s%s" "$GREEN_BOLD"  "PASS"       "$RESET" ;;
  esac
}

print_box() {
  local gate="$1" verdict="$2" summary="$3" commits="${4:-}" files="${5:-0}"
  local gate_label="Push Gate"
  [[ "$gate" == "release" ]] && gate_label="Release Gate"
  local dashes
  dashes=$(printf '─%.0s' {1..50})

  echo ""
  printf "%s┌%s┐%s\n" "$GRAY" "$dashes" "$RESET"
  printf "%s│%s %-49s%s│%s\n" "$GRAY" "$RESET" "LLLL Guard — ${gate_label}" "$GRAY" "$RESET"

  # Result line — color the verdict word, pad based on visual width
  local result_prefix=" Result: "
  local pad=$(( 50 - ${#result_prefix} - ${#verdict} ))
  printf "%s│%s%s%s%*s%s│%s\n" \
    "$GRAY" "$RESET" "$result_prefix" "$(color_verdict "$verdict")" \
    "$pad" "" "$GRAY" "$RESET"

  printf "%s│%s %-49s%s│%s\n" "$GRAY" "$RESET" "Findings: ${summary}"    "$GRAY" "$RESET"
  if [[ -n "$commits" ]]; then
    printf "%s│%s %-49s%s│%s\n" "$GRAY" "$RESET" "Scanned: ${commits} commits, ${files} files" "$GRAY" "$RESET"
  else
    printf "%s│%s %-49s%s│%s\n" "$GRAY" "$RESET" "Scanned: ${files} files" "$GRAY" "$RESET"
  fi
  printf "%s└%s┘%s\n" "$GRAY" "$dashes" "$RESET"
  echo ""
}

redact_match() {
  # Never print a matched secret in full: terminal scrollback, CI logs and
  # screen shares are all exfiltration paths. Keep enough to locate the value.
  local s="$1" n=${#1}
  if [[ $n -le 12 ]]; then
    printf '%s' "****"
  else
    printf '%s...%s (%d chars, redacted)' "${s:0:4}" "${s: -4}" "$n"
  fi
}

print_finding() {
  # args: severity id title file line match category action
  local sev="$1" id="$2" title="$3" file="$4" line="$5" match="$6" category="$7" action="$8"
  local color
  case "$sev" in
    HARD_BLOCK) color="$RED_BOLD" ;;
    SOFT_BLOCK) color="$YELLOW_BOLD" ;;
    *)          color="$BLUE" ;;
  esac
  printf "  %s[%s]%s %s — %s%s%s\n" "$color" "$id" "$RESET" "$title" "$color" "$sev" "$RESET"
  if [[ -n "$file" ]]; then
    local loc="$file"
    [[ -n "$line" ]] && loc="${file}:${line}"
    printf "  %s  File: %s%s\n" "$GRAY" "$loc" "$RESET"
  fi
  if [[ -n "$match" ]]; then
    printf "  %s  Match: %s%s\n" "$GRAY" "$(redact_match "$match")" "$RESET"
  fi
  printf "  %s  Category: %s%s\n" "$GRAY" "$category" "$RESET"
  printf "    Action: %s\n" "$action"
  echo ""
}

summarize_findings() {
  local h=${#HARD_FINDINGS[@]} s=${#SOFT_FINDINGS[@]} w=${#WARN_FINDINGS[@]}
  local parts=()
  [[ $h -gt 0 ]] && parts+=("${h} HARD_BLOCK")
  [[ $s -gt 0 ]] && parts+=("${s} SOFT_BLOCK")
  [[ $w -gt 0 ]] && parts+=("${w} WARN")
  [[ ${#parts[@]} -eq 0 ]] && echo "none" || ( IFS=', '; echo "${parts[*]}" )
}

print_results() {
  local gate="$1" verdict="$2" commits="${3:-}" files="${4:-0}"
  local summary
  summary=$(summarize_findings)

  print_box "$gate" "$verdict" "$summary" "$commits" "$files"

  if [[ ${#HARD_FINDINGS[@]} -eq 0 && ${#SOFT_FINDINGS[@]} -eq 0 && ${#WARN_FINDINGS[@]} -eq 0 ]]; then
    printf "  %sNo issues found. Safe to proceed.%s\n\n" "$GREEN_BOLD" "$RESET"
    return
  fi

  if [[ ${#HARD_FINDINGS[@]} -gt 0 ]]; then
    printf "  %sHARD_BLOCK — Must fix before proceeding:%s\n\n" "$RED_BOLD" "$RESET"
    for f in "${HARD_FINDINGS[@]}"; do
      IFS='|' read -r id title file line match category action <<< "$f"
      print_finding "HARD_BLOCK" "$id" "$title" "$file" "$line" "$match" "$category" "$action"
    done
  fi

  if [[ ${#SOFT_FINDINGS[@]} -gt 0 ]]; then
    printf "  %sSOFT_BLOCK — Requires review or override:%s\n\n" "$YELLOW_BOLD" "$RESET"
    for f in "${SOFT_FINDINGS[@]}"; do
      IFS='|' read -r id title file line match category action <<< "$f"
      print_finding "SOFT_BLOCK" "$id" "$title" "$file" "$line" "$match" "$category" "$action"
    done
    printf "  %sOverride with: llll-guard override <FINDING-ID> \"<justification>\"%s\n\n" "$YELLOW_BOLD" "$RESET"
  fi

  if [[ ${#WARN_FINDINGS[@]} -gt 0 ]]; then
    printf "  %sWARN — Worth noting:%s\n\n" "$BLUE" "$RESET"
    for f in "${WARN_FINDINGS[@]}"; do
      IFS='|' read -r id title file line match category action <<< "$f"
      print_finding "WARN" "$id" "$title" "$file" "$line" "$match" "$category" "$action"
    done
  fi
}

# ── Finding helpers ────────────────────────────────────────────────────────

# Some credentials are published deliberately: scaffold templates ship a shared
# demo RPC endpoint so the repo works after a clone, and client-side frameworks
# bundle "public" keys into the browser by design. Treating those as leaks
# produces false HARD_BLOCKs and tells the user to rotate a key that is meant to
# be shared. Detect the intent and downgrade — never suppress.
#
# Returns a reason on stdout and 0 when the value looks public by design.
public_by_design_reason() {
  local line="$1" file="${2:-}" id="${3:-}"

  # Private key material is never public by design, wherever it appears.
  [[ "$id" == "PG-H005" ]] && return 1

  # 1. Framework prefixes that mean "shipped to the client".
  if [[ "$line" =~ (NEXT_PUBLIC_|NUXT_PUBLIC_|EXPO_PUBLIC_|REACT_APP_|GATSBY_|VITE_) ]]; then
    printf 'client-exposed variable prefix %s' "${BASH_REMATCH[1]}"
    return 0
  fi

  # 2. The finding is itself inside an env template.
  case "$file" in
    *.env.example|*.env.sample|*.env.template|*.env.defaults)
      printf 'declared in an env template'
      return 0 ;;
  esac

  # 3. The same value is already distributed in a tracked template or the README.
  local tok where
  while read -r tok; do
    [[ -z "$tok" ]] && continue
    where=$(git grep -l --fixed-strings -- "$tok" -- \
      '*.env.example' '*.env.sample' '*.env.template' 'README*' 2>/dev/null | head -1)
    if [[ -n "$where" ]]; then
      printf 'same value is published in %s' "$where"
      return 0
    fi
  done < <(printf '%s' "$line" | grep -oE '[A-Za-z0-9_-]{16,}' 2>/dev/null || true)

  return 1
}

add_finding() {
  local sev="$1" id="$2" title="$3" file="${4:-}" line="${5:-}" match="${6:-}" category="$7" action="$8"

  if [[ "$sev" == "HARD" && "$category" == "secret" ]]; then
    local reason
    if reason=$(public_by_design_reason "$match" "$file" "$id"); then
      sev="WARN"
      title="${title} — published on purpose"
      action="Shared public endpoint: ${reason}. Not a leak. Confirm the quota/billing exposure is intended and that forks inheriting this value is acceptable."
    fi
  fi

  # truncate match to avoid pipe separator issues
  match="${match:0:100}"
  local entry="${id}|${title}|${file}|${line}|${match}|${category}|${action}"
  case "$sev" in
    HARD) HARD_FINDINGS+=("$entry") ;;
    SOFT) SOFT_FINDINGS+=("$entry") ;;
    WARN) WARN_FINDINGS+=("$entry") ;;
  esac
}

# scan_content SEV ID TITLE CATEGORY ACTION PATTERN [grep_flags]
# Scans $SCAN_CONTENT; on match adds finding with file=SCAN_FILE.
scan_content() {
  local sev="$1" id="$2" title="$3" category="$4" action="$5" pattern="$6" flags="${7:--E}"
  local hit
  hit=$(printf '%s\n' "$SCAN_CONTENT" | grep -m1 $flags "$pattern" 2>/dev/null || true)
  if [[ -n "$hit" ]]; then
    local lineno
    lineno=$(printf '%s\n' "$SCAN_CONTENT_NUMBERED" | grep -m1 $flags "$pattern" 2>/dev/null | cut -d: -f1 || true)
    add_finding "$sev" "$id" "$title" "$SCAN_FILE" "$lineno" "$hit" "$category" "$action"
  fi
}

# scan_paths SEV ID TITLE CATEGORY ACTION PATTERN
# Scans $CHANGED_FILES for path pattern.
scan_paths() {
  local sev="$1" id="$2" title="$3" category="$4" action="$5" pattern="$6"
  local hit
  hit=$(printf '%s\n' "$CHANGED_FILES" | grep -m1 -E "$pattern" 2>/dev/null || true)
  [[ -n "$hit" ]] && add_finding "$sev" "$id" "$title" "$hit" "" "" "$category" "$action"
}

# ── Push gate ──────────────────────────────────────────────────────────────

run_push() {
  local remote="origin" branch="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --remote) remote="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --json)   json=1; shift ;;
      *) shift ;;
    esac
  done

  [[ -z "$branch" ]] && branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")

  local range="${remote}/${branch}..HEAD"
  local diff_content commit_count=0 file_list=""

  diff_content=$(git diff "$range" --unified=0 2>/dev/null) || \
  diff_content=$(git diff "origin/main..HEAD" --unified=0 2>/dev/null) || \
  diff_content=$(git diff "HEAD~1..HEAD" --unified=0 2>/dev/null) || true

  if [[ -z "$diff_content" ]]; then
    echo "No outgoing commits found. Nothing to scan."
    return 0
  fi

  commit_count=$(git log --oneline "$range" 2>/dev/null | wc -l | tr -d ' ') || commit_count=1
  file_list=$(git diff --name-only "$range" 2>/dev/null || true)
  local file_count
  file_count=$(printf '%s\n' "$file_list" | grep -c . 2>/dev/null || echo 0)

  CHANGED_FILES="$file_list"

  # Load .guardignore
  local ignore_patterns=()
  if [[ -f .guardignore ]]; then
    while IFS= read -r pat || [[ -n "$pat" ]]; do
      [[ "$pat" =~ ^#.*$ || -z "$pat" ]] && continue
      ignore_patterns+=("$pat")
    done < .guardignore
  fi

  # Process each changed file's added lines
  local current_file="" in_hunk=0
  declare -A file_added_lines
  while IFS= read -r dl; do
    if [[ "$dl" =~ ^diff\ --git\ .*\ b/(.+)$ ]]; then
      current_file="${BASH_REMATCH[1]}"
      in_hunk=0
    elif [[ "$dl" == @@* ]]; then
      # Prefix match only: git appends function context after the closing @@
      # for languages with a funcname pattern (Python, Java, C, Rust, ...).
      # An end-anchored match silently skips every added line in those files.
      in_hunk=1
    elif [[ "$dl" =~ ^\+[^+] && $in_hunk -eq 1 && -n "$current_file" ]]; then
      file_added_lines["$current_file"]+="${dl:1}"$'\n'
    fi
  done <<< "$diff_content"

  # Scan each file
  for fpath in "${!file_added_lines[@]}"; do
    # Check guardignore
    local ignored=0
    for pat in "${ignore_patterns[@]}"; do
      # Simple glob match
      case "$fpath" in
        $pat) ignored=1; break ;;
      esac
    done
    [[ $ignored -eq 1 ]] && continue
    # Skip excluded extensions
    case "$fpath" in
      *.md|*.txt|*.lock|yarn.lock|package-lock.json|CHANGELOG*|LICENSE*) continue ;;
    esac

    SCAN_FILE="$fpath"
    SCAN_CONTENT="${file_added_lines[$fpath]}"
    SCAN_CONTENT_NUMBERED=$(printf '%s\n' "$SCAN_CONTENT" | grep -n '' 2>/dev/null || true)

    # HARD_BLOCK — secrets
    scan_content HARD PG-H001 "AWS Access Key ID"             secret   "Remove credential and rotate key"                        'AKIA[0-9A-Z]{16}'
    scan_content HARD PG-H002 "OpenAI/Stripe secret key"      secret   "Move to environment variable"                            'sk-[a-zA-Z0-9]{20,}'
    scan_content HARD PG-H003 "GitHub personal access token"  secret   "Revoke token and move to env var"                        'ghp_[a-zA-Z0-9]{36}'
    scan_content HARD PG-H004 "GitHub OAuth access token"     secret   "Revoke token and move to env var"                        'gho_[a-zA-Z0-9]{36}'
    scan_content HARD PG-H005 "Private key material"          secret   "Remove key material from source"                         '-----BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE KEY-----'
    scan_content HARD PG-H006 "Hardcoded API key assignment"  secret   "Move to environment variable"                            '(api[_-]?key|api[_-]?secret|access[_-]?key)[[:space:]]*[=:][[:space:]]*["'"'"'][A-Za-z0-9+/=]{16,}["'"'"']' "-iE"
    scan_content HARD PG-H007 "Hardcoded password (>8 chars)" secret   "Move to environment variable or secrets manager"         '(password|passwd|pwd)[[:space:]]*[=:][[:space:]]*["'"'"'][^"'"'"']{8,}["'"'"']' "-iE"
    scan_content HARD PG-H008 "Database credential"           secret   "Move connection string to environment variable"          '(database_url|db_password|db_pass|mongo_uri|redis_url)[[:space:]]*[=:][[:space:]]*["'"'"'][^"'"'"']+["'"'"']' "-iE"
    scan_content HARD PG-H009 "Hardcoded bearer token"        secret   "Move to environment variable"                            'bearer[[:space:]]+[A-Za-z0-9_.~=/-]{8,}' "-iE"
    scan_content HARD PG-H012 "SSN pattern"                   data     "Remove PII from source code"                             '[0-9]{3}-[0-9]{2}-[0-9]{4}'
    scan_content HARD PG-H013 "Credit card number pattern"    data     "Remove PII from source code"                             '[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}[- ]?[0-9]{4}'

    # SOFT_BLOCK — policy
    scan_content SOFT PG-S001 "Upload capability added"          feature  "Review Domain G (UGC) compliance before merging"         '(multer|formidable|busboy|multipart.form)' "-iE"
    scan_content SOFT PG-S002 "Payment feature added"            feature  "Review Domain F (Payments) compliance before merging"    '(stripe|paypal|braintree)\.' "-iE"
    scan_content SOFT PG-S003 "Minors-related feature"           feature  "Review Domain M (Sensitive Sector) — COPPA implications" '(coppa|age.?gate|parental.?consent)' "-iE"
    scan_content SOFT PG-S004 "AI integration added"             feature  "Add AI disclosure, review output handling and guardrails" '(require.*openai|from.*openai|require.*anthropic|from.*anthropic|new OpenAI|new Anthropic|langchain)' "-E"
    scan_content SOFT PG-S005 "User tracking added"              feature  "Review Domain D (Privacy) — add consent mechanism"       '(mixpanel|segment\.io|amplitude|\"ga4\"|pixel.*track)' "-iE"
    scan_content SOFT PG-S006 "Location data access"             feature  "Review Domain D (Privacy) — add location disclosure"     '(navigator\.geolocation|requestLocation|CLLocationManager)' "-E"
    scan_content SOFT PG-S007 "Biometric feature"                feature  "Review Domain M (Sensitive Sector) before merging"       '(faceapi|FaceDetector|TouchID|FaceID|BiometricPrompt)' "-iE"
    scan_content SOFT PG-S008 "Automated scoring/ranking"        feature  "Review Domain J (Automated Decisions) before merging"    '(creditScore|riskScore|eligibilityScore|rankModel)' "-iE"
    scan_content SOFT PG-S009 "Copyleft license dependency"      license  "Review Domain O — verify license compatibility"          '"(agpl|GPL-[23])' "-iE"
    scan_content SOFT PG-S010 "Data retention change"            feature  "Review Domain D (Privacy) — update retention policy"     '(retentionPolicy|delete_after|purge_after|data.*ttl)' "-iE"

    # WARN
    scan_content WARN PG-W001 "Unresolved markers"              hygiene  "Resolve before merging to main"                          '(TODO|FIXME|HACK|XXX):'
    scan_content WARN PG-W002 "Debug output in production code" hygiene  "Remove before shipping"                                  '(console\.(log|debug)|debugger;)'
  done

  # File path HARD_BLOCK patterns
  local env_hit
  env_hit=$(printf '%s\n' "$file_list" | grep -E '(^|/)\.env$' 2>/dev/null | head -1 || true)
  [[ -n "$env_hit" ]] && add_finding HARD PG-H010 ".env file committed" "$env_hit" "" "" secret "Remove from repo and rotate any exposed credentials"

  scan_paths HARD PG-H011 "Private key file committed"          secret  "Remove from repo and rotate key"                         '\.(pem|key|p12|pfx)$|/(id_rsa|id_ed25519)[^/]*$'
  scan_paths HARD PG-H014 "Internal analysis file committed"    internal "Remove file — must not be public" \
    '(Competitive_Analysis|Full_Analysis|AGENT_PROMPT_|MCP_analysis)'

  # New dependency WARN (manifest files only)
  local manifest_hit
  manifest_hit=$(printf '%s\n' "$file_list" | grep -E '(package\.json|requirements\.txt|Cargo\.toml|go\.mod)$' 2>/dev/null | head -1 || true)
  [[ -n "$manifest_hit" ]] && add_finding WARN PG-W003 "Dependency manifest changed" "$manifest_hit" "" "" dependency "Review new dependencies for license and security"

  # Determine verdict
  local verdict="PASS"
  [[ ${#HARD_FINDINGS[@]} -gt 0 ]] && verdict="HARD_BLOCK"
  [[ ${#HARD_FINDINGS[@]} -eq 0 && ${#SOFT_FINDINGS[@]} -gt 0 ]] && verdict="SOFT_BLOCK"
  [[ ${#HARD_FINDINGS[@]} -eq 0 && ${#SOFT_FINDINGS[@]} -eq 0 && ${#WARN_FINDINGS[@]} -gt 0 ]] && verdict="WARN"

  print_results "push" "$verdict" "$commit_count" "$file_count"

  case "$verdict" in
    HARD_BLOCK|SOFT_BLOCK) return 1 ;;
    *) return 0 ;;
  esac
}

# ── Release gate ───────────────────────────────────────────────────────────

run_release() {
  local dir="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir)  dir="$2"; shift 2 ;;
      --json) json=1; shift ;;
      *) shift ;;
    esac
  done

  local artifact_list=""

  if command -v npm >/dev/null 2>&1 && [[ -f package.json ]]; then
    artifact_list=$(npm pack --dry-run 2>/dev/null | grep -v '^npm ' | grep -v '^Tarball' | grep -v '^total' || true)
  elif [[ -n "$dir" ]]; then
    artifact_list=$(find "$dir" -type f 2>/dev/null || true)
  else
    for d in dist lib build; do
      [[ -d "$d" ]] && { artifact_list=$(find "$d" -type f 2>/dev/null || true); break; }
    done
  fi

  if [[ -z "$artifact_list" ]]; then
    echo "Cannot determine release artifact list. Run 'npm pack --dry-run' and inspect manually."
    return 0
  fi

  CHANGED_FILES="$artifact_list"
  SCAN_CONTENT="" SCAN_FILE="" SCAN_CONTENT_NUMBERED=""
  local file_count
  file_count=$(printf '%s\n' "$artifact_list" | grep -c . 2>/dev/null || echo 0)

  scan_paths HARD RG-H001 ".env file in release"              secret   "Remove from release via .npmignore or 'files' field"   '(^|/)\.env$'
  scan_paths HARD RG-H002 "Private key in release"            secret   "Remove from release"                                    '\.(pem|key|p12|pfx)$|id_(rsa|ed25519)'
  scan_paths HARD RG-H004 "Source map in release"             leakage  "Exclude *.map files via .npmignore"                     '\.map$'
  scan_paths SOFT RG-S001 "Source directory in release"       leakage  "Exclude src/ via .npmignore or 'files' field"          '(^|/)src/'
  scan_paths SOFT RG-S002 "Test files in release"             leakage  "Exclude test files via .npmignore"                     '(^|/)(test|tests|__tests__|spec)/|(\.(test|spec)\.[a-z]+$)'
  scan_paths SOFT RG-S003 "Internal directory in release"     leakage  "Exclude internal/ via .npmignore"                      '(^|/)(internal|private)/'
  scan_paths SOFT RG-S004 "Prompt/skill files in release"     leakage  "Exclude AI prompt files via .npmignore"                '(SKILL\.md|AGENTS\.md|system.?prompt)'
  scan_paths SOFT RG-S005 "Dev tooling in release"            leakage  "Exclude scripts/ and Makefile via .npmignore"          '(^|/)(tools|scripts)/|(Makefile|Taskfile)'

  if [[ -f package.json ]]; then
    if ! grep -q '"files"' package.json 2>/dev/null && [[ ! -f .npmignore ]]; then
      add_finding SOFT RG-S006 "No release whitelist" "package.json" "" "" policy "Add 'files' array to package.json or create .npmignore"
    fi
  fi

  local verdict="PASS"
  [[ ${#HARD_FINDINGS[@]} -gt 0 ]] && verdict="HARD_BLOCK"
  [[ ${#HARD_FINDINGS[@]} -eq 0 && ${#SOFT_FINDINGS[@]} -gt 0 ]] && verdict="SOFT_BLOCK"

  print_results "release" "$verdict" "" "$file_count"

  case "$verdict" in
    HARD_BLOCK|SOFT_BLOCK) return 1 ;;
    *) return 0 ;;
  esac
}

# ── Override command ───────────────────────────────────────────────────────

json_escape() {
  # Raw interpolation of user text produces invalid JSONL as soon as the
  # justification contains a quote or backslash, corrupting the whole log.
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  printf '%s' "$s"
}

run_override() {
  local finding_id="${1:-}" justification="${2:-}"
  if [[ -z "$finding_id" || -z "$justification" ]]; then
    echo "Usage: guard override <findingId> \"<justification>\"" >&2
    return 1
  fi

  # Anchor to the repo root: a cwd-relative path creates a second, orphaned
  # log whenever override is run from a subdirectory.
  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
  local log_dir="${repo_root}/.llll/logs"
  mkdir -p "$log_dir"
  local log_file="${log_dir}/guard-log.jsonl"

  local actor
  actor=$(git config user.email 2>/dev/null || echo "unknown")
  local timestamp
  timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  printf '{"timestamp":"%s","action":"override","findingIds":["%s"],"actor":"%s","justification":"%s","filesAffected":[],"verdictBefore":"SOFT_BLOCK","verdictAfter":"PASS (overridden)"}\n' \
    "$timestamp" "$(json_escape "$finding_id")" "$(json_escape "$actor")" "$(json_escape "$justification")" >> "$log_file"

  printf "Override recorded for %s\n" "$finding_id"
  printf "  Actor: %s\n" "$actor"
  printf "  Justification: %s\n" "$justification"
  printf "  Logged to: %s\n" "$log_file"
  echo ""
  printf "%sWarning: This override is logged for compliance audit.%s\n" "$YELLOW_BOLD" "$RESET"
}

# ── Install hook command ───────────────────────────────────────────────────

run_install_hook() {
  local force=0
  [[ "${1:-}" == "--force" ]] && force=1

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Not a git repository. Run from a project root." >&2
    return 1
  fi

  # In a worktree or submodule, .git is a file, not a directory — a hardcoded
  # <root>/.git/hooks path fails there. Ask git where the hooks actually live.
  local hooks_dir hook_path
  hooks_dir=$(git rev-parse --git-path hooks 2>/dev/null)
  if [[ -z "$hooks_dir" ]]; then
    echo "Could not resolve the git hooks directory." >&2
    return 1
  fi
  mkdir -p "$hooks_dir" || { echo "Could not create ${hooks_dir}." >&2; return 1; }
  hook_path="${hooks_dir}/pre-push"

  if [[ -f "$hook_path" && $force -eq 0 ]]; then
    if grep -q 'LLLL Guard' "$hook_path" 2>/dev/null; then
      echo "LLLL Guard pre-push hook is already installed."
      return 0
    fi
    echo "A pre-push hook already exists. Use --force to overwrite." >&2
    return 1
  fi

  cat > "$hook_path" << HOOK_EOF
#!/bin/sh
# LLLL Guard — Pre-Push Compliance Gate
# Installed by: guard install-hook

echo "LLLL Guard: Scanning outgoing changes..."
"${GUARD_SCRIPT}" push

exit_code=\$?
if [ \$exit_code -ne 0 ]; then
  echo ""
  echo "LLLL Guard: Push blocked. Fix findings above or use 'guard override' for SOFT_BLOCK items."
  exit \$exit_code
fi
HOOK_EOF

  # The script runs without `set -e`; without these checks a failed write is
  # reported as a successful install and the repo is left ungated.
  if [[ ! -s "$hook_path" ]]; then
    echo "Failed to write the pre-push hook to ${hook_path}." >&2
    return 1
  fi
  chmod 755 "$hook_path" || { echo "Failed to make ${hook_path} executable." >&2; return 1; }
  printf "%sLLLL Guard pre-push hook installed successfully.%s\n" "$GREEN_BOLD" "$RESET"
  printf "  Location: %s\n\n" "$hook_path"
  echo "The hook will run 'guard push' before every git push."
  echo "To uninstall, delete the hook: rm ${hook_path}"
}

# ── Entry point ────────────────────────────────────────────────────────────

# When sourced, stop here and expose the functions only — this lets tests
# exercise individual rules without running a gate.
[[ "${BASH_SOURCE[0]}" != "${0}" ]] && return 0

CMD="${1:-}"
shift 2>/dev/null || true

case "$CMD" in
  push)         run_push "$@" ;;
  release)      run_release "$@" ;;
  override)     run_override "$@" ;;
  install-hook) run_install_hook "$@" ;;
  "")
    echo "LLLL Guard — Part of LLLL (Layrix Logic Layer Loop)"
    echo ""
    echo "Usage:"
    echo "  guard push [--remote <remote>] [--branch <branch>]"
    echo "  guard release [--dir <dir>]"
    echo "  guard override <findingId> \"<justification>\""
    echo "  guard install-hook [--force]"
    ;;
  *)
    echo "Unknown command: $CMD" >&2
    echo "Run 'guard' with no arguments for usage." >&2
    exit 1
    ;;
esac
