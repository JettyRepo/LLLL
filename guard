#!/usr/bin/env bash
# LLLL-GUARD-SHIM — launcher for the LLLL Guard engine (llll-guard/, TypeScript, Node >= 20).
#
# This file holds no rules. It finds Node and the engine and hands over. Written for bash 3.2
# (stock macOS): no associative arrays, no `set -u` with empty arrays.
#
#   guard push|release|override|install-hook|uninstall-hook|hook ...   run the engine
#   guard doctor [--fix]                                               what is found, and build it
#   guard --version
#
# Missing Node or engine:
#   - hook runs (what git starts): warn, leave a marker file, let the push through. This is the
#     0.2.x migration default. LLLL_GUARD_STRICT=1 stops the push instead (exit 2).
#   - every other command: exit 2. Never 0.
#
# Environment: LLLL_NODE (node binary), LLLL_GUARD_BIN (engine entry point), LLLL_GUARD_STRICT.

SELF="$0"
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case "$link" in
    /*) SELF="$link" ;;
    *) SELF="$(dirname "$SELF")/$link" ;;
  esac
done
SELF_DIR=$(cd "$(dirname "$SELF")" 2>/dev/null && pwd -P)
SELF="$SELF_DIR/$(basename "$SELF")"

node_ok() {
  [ -n "$1" ] && [ -x "$1" ] && "$1" -e 'process.exit(parseInt(process.versions.node, 10) >= 20 ? 0 : 1)' >/dev/null 2>&1
}

find_node() {
  local candidate
  if [ -n "${LLLL_NODE:-}" ]; then
    node_ok "$LLLL_NODE" && { echo "$LLLL_NODE"; return 0; }
    return 1
  fi
  candidate=$(command -v node 2>/dev/null)
  node_ok "$candidate" && { echo "$candidate"; return 0; }
  # A git hook gets a bare PATH from some GUIs; look where version managers and Homebrew put node.
  for candidate in \
    /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node \
    "$HOME/.volta/bin/node" \
    "$HOME"/.nvm/versions/node/*/bin/node \
    "$HOME"/.local/share/fnm/node-versions/*/installation/bin/node \
    "$HOME"/Library/Application\ Support/fnm/node-versions/*/installation/bin/node \
    "$HOME"/.asdf/shims/node "$HOME"/.local/share/mise/shims/node; do
    node_ok "$candidate" && { echo "$candidate"; return 0; }
  done
  return 1
}

# Sets ENGINE to the engine entry point (a JS file, or a bin link to one); run it with node.
find_engine() {
  local top candidate
  ENGINE=""
  if [ -n "${LLLL_GUARD_BIN:-}" ]; then
    [ -f "$LLLL_GUARD_BIN" ] && { ENGINE="$LLLL_GUARD_BIN"; return 0; }
    return 1
  fi
  if [ -f "$SELF_DIR/llll-guard/dist/index.js" ]; then
    ENGINE="$SELF_DIR/llll-guard/dist/index.js"
    return 0
  fi
  top=$(git rev-parse --show-toplevel 2>/dev/null)
  if [ -n "$top" ] && [ -x "$top/node_modules/.bin/llll-guard" ]; then
    ENGINE="$top/node_modules/.bin/llll-guard"
    return 0
  fi
  candidate=$(command -v llll-guard 2>/dev/null)
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    ENGINE="$candidate"
    return 0
  fi
  return 1
}

mark_not_run() {
  local top dir
  top=$(git rev-parse --show-toplevel 2>/dev/null)
  dir="$top/.llll/logs"
  if [ -z "$top" ] || ! mkdir -p "$dir" 2>/dev/null \
    || ! echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $1" >> "$dir/guard-not-run.log" 2>/dev/null; then
    echo "LLLL Guard: could not write the not-run marker (.llll/logs/guard-not-run.log)." >&2
  fi
  return 0
}

cannot_run() {
  # $1 = reason, $2 = "hook" when git started us
  echo "LLLL Guard: $1" >&2
  echo "LLLL Guard: run '$SELF doctor' to see what is missing, or '$SELF doctor --fix' to build it." >&2
  if [ "$2" = "hook" ]; then
    mark_not_run "$1"
    if [ "${LLLL_GUARD_STRICT:-0}" = "1" ]; then
      echo "LLLL Guard: LLLL_GUARD_STRICT=1, so this push is stopped." >&2
      exit 2
    fi
    echo "LLLL Guard: this push was NOT checked. (Set LLLL_GUARD_STRICT=1 to stop pushes instead; that becomes the default in 1.0.)" >&2
    exit 0
  fi
  exit 2
}

doctor() {
  local node version="" rc=0
  echo "LLLL Guard doctor"
  echo "  launcher: $SELF"
  node=$(find_node)
  if [ -n "$node" ]; then
    echo "  node:     $node ($("$node" --version 2>/dev/null))"
  else
    echo "  node:     NOT FOUND (version 20 or newer is needed; set LLLL_NODE to a node binary)"
    rc=2
  fi
  find_engine
  if [ -z "$ENGINE" ] && [ "$1" = "--fix" ] && [ -f "$SELF_DIR/llll-guard/package.json" ] && [ -n "$node" ]; then
    echo "  engine:   not built; building in $SELF_DIR/llll-guard (npm ci && npm run build)"
    if (cd "$SELF_DIR/llll-guard" && PATH="$(dirname "$node"):$PATH" npm ci && PATH="$(dirname "$node"):$PATH" npm run build); then
      find_engine
    else
      echo "  engine:   build FAILED" >&2
      exit 2
    fi
  fi
  if [ -n "$ENGINE" ]; then
    [ -n "$node" ] && version=$("$node" "$ENGINE" --version 2>/dev/null)
    echo "  engine:   $ENGINE (${version:-version unknown})"
  else
    echo "  engine:   NOT FOUND (run '$SELF doctor --fix' in a clone, or: npm install -g @layrix.ai/llll-guard)"
    rc=2
  fi
  echo "  strict:   ${LLLL_GUARD_STRICT:-0} (1 = a push is stopped when the guard cannot run)"
  exit $rc
}

CMD="${1:-}"

case "$CMD" in
  doctor)
    shift
    doctor "${1:-}"
    ;;
esac

IS_HOOK=""
[ "$CMD" = "hook" ] && IS_HOOK=hook

# A pre-push hook written by an earlier version runs `guard push` with git's stdin and no arguments.
# Git sets GIT_EXEC_PATH and GIT_PREFIX for aliases and every other hook too, and those have no refs
# on stdin: reading nothing would scan nothing and pass. So the caller must be a script named pre-push.
LEGACY=""
if [ "$CMD" = "push" ] && [ "$#" -eq 1 ] && [ -n "${GIT_EXEC_PATH:-}" ] && [ -n "${GIT_PREFIX+x}" ] && [ ! -t 0 ]; then
  case "$(ps -o args= -p "$PPID" 2>/dev/null)" in
    *pre-push*)
      LEGACY=1
      IS_HOOK=hook
      ;;
  esac
fi

if [ -z "$CMD" ] || [ "$CMD" = "--help" ] || [ "$CMD" = "-h" ]; then
  NODE=$(find_node)
  find_engine
  if [ -n "$NODE" ] && [ -n "$ENGINE" ]; then
    exec "$NODE" "$ENGINE" --help
  fi
  echo "Usage: guard push|release|override|install-hook|uninstall-hook|doctor [--fix]|--version" >&2
  [ -z "$CMD" ] && exit 2
  exit 0
fi

NODE=$(find_node)
find_engine
if [ -z "$ENGINE" ]; then
  cannot_run "the engine (llll-guard) was not found." "$IS_HOOK"
fi
if [ -z "$NODE" ]; then
  cannot_run "Node.js 20 or newer was not found." "$IS_HOOK"
fi

if [ -n "$LEGACY" ]; then
  echo "LLLL Guard: this hook is from an older version. Run 'guard install-hook' to replace it." >&2
  set -- push --stdin
fi

if [ "$CMD" = "install-hook" ]; then
  shift
  set -- install-hook --shim "$SELF" "$@"
fi

# Run a JavaScript entry point with the node found above. Anything else (a pnpm or volta shim on
# PATH) is a program of its own: running it with node would fail with a syntax error, exit 1, and
# be read as "blocked".
case "$ENGINE" in
  *.js|*.mjs|*.cjs) exec "$NODE" "$ENGINE" "$@" ;;
esac
case "$(head -n 1 "$ENGINE" 2>/dev/null)" in
  "#!"*node*) exec "$NODE" "$ENGINE" "$@" ;;
esac
exec "$ENGINE" "$@"
